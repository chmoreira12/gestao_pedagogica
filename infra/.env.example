# Copie para infra/.env e preencha com senhas locais distintas.
# As variáveis abaixo são obrigatórias. Este exemplo não contém senhas.
# Para valores com $ ou #, use aspas simples conforme a sintaxe .env do Compose.

# Senha administrativa da instância (usuário postgres).
POSTGRES_PASSWORD=

# Senha do usuário academico_user, proprietário do banco academico_db.
ACADEMICO_DB_PASSWORD=

# Senha do usuário identidade_user, proprietário do banco identidade_db.
IDENTIDADE_DB_PASSWORD=
